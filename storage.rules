
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    // Enhanced image validation with security checks
    function isValidImage() {
      return request.resource.contentType.matches('image/(jpeg|png|gif|webp)') &&
             request.resource.size < 5 * 1024 * 1024 && // 5MB limit
             request.resource.size > 1024; // Minimum 1KB to prevent malicious tiny files
    }
    
    // Enhanced document validation
    function isValidDocument() {
      return (request.resource.contentType.matches('application/pdf') || 
              request.resource.contentType.matches('application/msword') ||
              request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
              request.resource.contentType.matches('text/plain')) &&
             request.resource.size < 10 * 1024 * 1024 && // 10MB limit
             request.resource.size > 100; // Minimum 100 bytes
    }
    
    // Check for malicious file names
    function isSafeFileName(fileName) {
      return !fileName.matches('.*\\.(exe|bat|cmd|scr|pif|com|js|jar|php|asp|jsp)$') &&
             fileName.size() <= 255 &&
             fileName.size() > 0;
    }
    
    // Profile images with enhanced security
    match /profiles/{userId}/{fileName} {
      allow read: if isSafeFileName(fileName);
      
      allow write: if isSignedIn() && 
                     isEmailVerified() &&
                     (isOwner(userId) || isAdmin()) && 
                     isValidImage() &&
                     isSafeFileName(fileName);
      
      allow delete: if isSignedIn() && 
                      (isOwner(userId) || isAdmin());
    }
    
    // Encrypted resumes with strict access control
    match /resumes/{userId}/{fileName} {
      allow read: if isSignedIn() && 
                    (isOwner(userId) || 
                     firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userType == 'restaurant' || 
                     isAdmin()) &&
                    isSafeFileName(fileName);
      
      allow write: if isSignedIn() && 
                     isEmailVerified() &&
                     (isOwner(userId) || isAdmin()) && 
                     isValidDocument() &&
                     isSafeFileName(fileName);
      
      allow delete: if isSignedIn() && 
                      (isOwner(userId) || isAdmin());
    }
    
    // Job attachments with validation
    match /jobs/{jobId}/{fileName} {
      allow read: if isSafeFileName(fileName);
      
      allow write: if isSignedIn() && 
                     isEmailVerified() &&
                     (firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.createdBy == request.auth.uid || 
                      isAdmin()) &&
                     (isValidImage() || isValidDocument()) &&
                     isSafeFileName(fileName);
      
      allow delete: if isSignedIn() && 
                      (firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.createdBy == request.auth.uid || 
                       isAdmin());
    }
    
    // Encrypted chat attachments
    match /chat_attachments/{conversationId}/{messageId}/{fileName} {
      allow read: if isSignedIn() && 
                    (request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants) &&
                    isSafeFileName(fileName);
      
      allow write: if isSignedIn() &&
                     isEmailVerified() &&
                     (request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants) &&
                     (isValidImage() || isValidDocument()) &&
                     isSafeFileName(fileName) &&
                     // Additional size restrictions for chat
                     ((request.resource.contentType.matches('image/.*') && request.resource.size < 3 * 1024 * 1024) ||
                      (request.resource.contentType.matches('application/pdf') && request.resource.size < 5 * 1024 * 1024) ||
                      (request.resource.contentType.matches('text/plain') && request.resource.size < 1 * 1024 * 1024));
      
      allow delete: if isSignedIn() && 
                      (isAdmin() || 
                       firestore.get(/databases/(default)/documents/messages/$(messageId)).data.senderId == request.auth.uid);
    }
    
    // Secure backup storage (admin only)
    match /backups/{userId}/{fileName} {
      allow read, write, delete: if isSignedIn() && isAdmin();
    }
    
    // Audit trail files (immutable, admin only)
    match /audit_files/{year}/{month}/{fileName} {
      allow read: if isSignedIn() && isAdmin();
      allow write: if isSignedIn() && isAdmin();
      allow delete: if false; // Audit files are immutable
    }
  }
}
