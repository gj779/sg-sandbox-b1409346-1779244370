rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Ensure this path matches your Firestore structure for user roles
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }
    
    // Validate image properties: type and size (e.g., max 5MB)
    function isValidImage() {
      return request.resource.contentType.matches('image/.*') &&
             request.resource.size < 5 * 1024 * 1024; 
    }
    
    // Validate resume properties: type (PDF, DOC, DOCX) and size (e.g., max 10MB)
    function isValidResume() {
      return (request.resource.contentType.matches('application/pdf') || 
              request.resource.contentType.matches('application/msword') ||
              request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document')) &&
             request.resource.size < 10 * 1024 * 1024;
    }
    
    // Profile images: stored under profiles/{userId}/{fileName}
    match /profiles/{userId}/{fileName} {
      // Anyone can read profile images (if public)
      allow read: if true; 
      
      // Only the authenticated owner of the profile or an admin can upload/update.
      // Validate that it's an image and within size limits.
      allow write: if isSignedIn() && 
                     (isOwner(userId) || isAdmin()) && 
                     isValidImage();
      
      // Only the owner or an admin can delete their profile image.
      allow delete: if isSignedIn() && 
                      (isOwner(userId) || isAdmin());
    }
    
    // Resumes: stored under resumes/{userId}/{fileName}
    match /resumes/{userId}/{fileName} {
      // Owner, relevant restaurant users (e.g., if applied to their job), or admins can read.
      // This rule might need to be more complex based on application logic (e.g., checking job applications).
      allow read: if isSignedIn() && 
                    (isOwner(userId) || 
                     firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userType == 'restaurant' || 
                     isAdmin());
      
      // Only the owner or an admin can upload/update their resume.
      // Validate file type and size.
      allow write: if isSignedIn() && 
                     (isOwner(userId) || isAdmin()) && 
                     isValidResume();
      
      // Only the owner or an admin can delete their resume.
      allow delete: if isSignedIn() && 
                      (isOwner(userId) || isAdmin());
    }
    
    // Job-related attachments (e.g., company logo for a job posting)
    // Stored under jobs/{jobId}/{fileName}
    match /jobs/{jobId}/{fileName} {
      // Anyone can read job attachments if they are public.
      allow read: if true; 
      
      // Only authenticated restaurant users who created the job or admins can upload.
      // Validate file type and size.
      allow write: if isSignedIn() && 
                     (firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.createdBy == request.auth.uid || 
                      isAdmin()) &&
                     (isValidImage() || isValidResume()); // Example: allow images or documents
      
      // Only the job creator or an admin can delete job attachments.
      allow delete: if isSignedIn() && 
                      (firestore.get(/databases/(default)/documents/jobs/$(jobId)).data.createdBy == request.auth.uid || 
                       isAdmin());
    }
    
    // Message attachments (e.g., images sent in chat)
    // Stored under messages/{conversationId}/{messageId}/{fileName} (example path)
    match /chat_attachments/{conversationId}/{messageId}/{fileName} {
      // Only participants of the conversation can read attachments.
      // This requires checking conversation participants in Firestore.
      allow read: if isSignedIn() && 
                    (request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants);
      
      // Only participants of the conversation can upload attachments.
      // Validate file type and size (e.g. max 10MB for general files, 5MB for images)
      allow write: if isSignedIn() &&
                     (request.auth.uid in firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants) &&
                     ( (request.resource.contentType.matches('image/.*') && request.resource.size < 5 * 1024 * 1024) ||
                       (request.resource.contentType.matches('application/pdf') && request.resource.size < 10 * 1024 * 1024) ||
                       (request.resource.contentType.matches('application/msword') && request.resource.size < 10 * 1024 * 1024) ||
                       (request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') && request.resource.size < 10 * 1024 * 1024) ||
                       (request.resource.contentType.matches('text/plain') && request.resource.size < 2 * 1024 * 1024) 
                     );
      
      // Only admins or perhaps the sender can delete (more complex logic might be needed).
      // For simplicity, allowing sender or admin to delete.
      allow delete: if isSignedIn() && 
                      (isAdmin() || 
                       firestore.get(/databases/(default)/documents/messages/$(messageId)).data.senderId == request.auth.uid);
    }
  }
}