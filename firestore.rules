
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      // Check if the user has an 'admin' role in their user profile
      // Ensure the path to the user document is correct
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }
    
    function isValidUserProfileData(data) {
      // Basic validation for user profile data
      return data.keys().hasAll(['email', 'userType', 'firstName', 'lastName']) &&
             (data.userType == 'applicant' || data.userType == 'restaurant' || data.userType == 'admin') &&
             data.email is string && data.email.matches('.+@.+\\..+') &&
             data.firstName is string && data.firstName.size() > 0 &&
             data.lastName is string && data.lastName.size() > 0;
    }

    // User profiles
    match /users/{userId} {
      // Authenticated users can read any profile (adjust if more privacy is needed)
      allow read: if isSignedIn();
      
      // Users can create their own profile document if it doesn't exist
      // Or admins can create profiles
      allow create: if isSignedIn() && 
                      (isOwner(userId) && isValidUserProfileData(request.resource.data)) || 
                      (isAdmin() && isValidUserProfileData(request.resource.data));
      
      // Only the owner or an admin can update their profile
      // Ensure that critical fields like email or userType are not changed arbitrarily
      allow update: if isSignedIn() && 
                      (isOwner(userId) || isAdmin()) &&
                      isValidUserProfileData(request.resource.data) &&
                      request.resource.data.email == resource.data.email && // Email shouldn't change
                      request.resource.data.userType == resource.data.userType; // UserType shouldn't change post-creation by user

      // Only admins can delete user profiles directly
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Jobs
    match /jobs/{jobId} {
      // Anyone can read job listings
      allow read: if true; // Or use isSignedIn() if jobs are not public
      
      // Only authenticated restaurant users or admins can create jobs
      allow create: if isSignedIn() && 
                      (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'restaurant' || isAdmin());
      
      // Only the job creator (restaurant user) or an admin can update or delete jobs
      allow update, delete: if isSignedIn() && 
                              (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    
    // Applications
    match /applications/{applicationId} {
      // Applicant can read their own applications
      // Restaurant (job poster) can read applications for their jobs
      // Admins can read any application
      allow read: if isSignedIn() && 
                    (resource.data.applicantId == request.auth.uid || 
                     resource.data.restaurantId == request.auth.uid || 
                     isAdmin());
      
      // Only authenticated applicant users can create applications for a job
      // Ensure applicantId in the application matches the authenticated user
      allow create: if isSignedIn() && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'applicant' &&
                      request.resource.data.applicantId == request.auth.uid;
      
      // Applicant can update their application (e.g., withdraw)
      // Restaurant can update application status (e.g., accepted, rejected)
      allow update: if isSignedIn() && 
                      (resource.data.applicantId == request.auth.uid || 
                       resource.data.restaurantId == request.auth.uid);
      
      // Only admins can delete applications (or perhaps applicant/restaurant under certain conditions)
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Messages
    match /messages/{messageId} {
      // Only participants in the conversation (sender or recipient) can read messages
      allow read: if isSignedIn() && 
                    (resource.data.senderId == request.auth.uid || 
                     resource.data.recipientId == request.auth.uid);
      
      // Users can only create messages where they are the sender
      allow create: if isSignedIn() && 
                      request.resource.data.senderId == request.auth.uid;
      
      // Messages generally should not be updated once sent to maintain integrity
      allow update: if false; 
      
      // Only admins can delete messages (consider if users should be able to delete their own)
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Conversations (metadata for chats)
    match /conversations/{conversationId} {
      // Only participants in the conversation can read its metadata
      allow read: if isSignedIn() && 
                    (request.auth.uid in resource.data.participants);
      
      // Users can create conversations they are part of
      allow create: if isSignedIn() && 
                      (request.auth.uid in request.resource.data.participants);
      
      // Only participants can update conversation metadata (e.g., lastMessage, unread counts)
      allow update: if isSignedIn() && 
                      (request.auth.uid in resource.data.participants);
      
      // Only admins can delete conversations
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Notifications
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isSignedIn() && 
                    resource.data.userId == request.auth.uid;
      
      // Notifications are typically created by the system (e.g., via Cloud Functions) or admins
      allow create: if isSignedIn() && isAdmin(); // Or allow server-side creation
      
      // Users can mark their own notifications as read/unread
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      
      // Only admins can delete notifications (or users their own)
      allow delete: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
    }
  }
}
