rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }
    
    function isValidUserProfileData(data) {
      return data.keys().hasAll(['email', 'userType', 'firstName', 'lastName']) &&
             (data.userType == 'applicant' || data.userType == 'restaurant' || data.userType == 'admin') &&
             data.email is string && data.email.matches('.+@.+\\..+') &&
             data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 50 &&
             data.lastName is string && data.lastName.size() > 0 && data.lastName.size() <= 50 &&
             // Optional fields - allow them if present
             (!data.keys().hasAny(['phoneNumber']) || (data.phoneNumber is string && data.phoneNumber.size() <= 20)) &&
             (!data.keys().hasAny(['bio']) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!data.keys().hasAny(['location']) || (data.location is string && data.location.size() <= 200)) &&
             (!data.keys().hasAny(['photoURL']) || (data.photoURL is string)) &&
             (!data.keys().hasAny(['avatarUrl']) || (data.avatarUrl is string)) &&
             (!data.keys().hasAny(['resumeUrl']) || (data.resumeUrl is string)) &&
             (!data.keys().hasAny(['preferredLocation']) || (data.preferredLocation is string)) &&
             (!data.keys().hasAny(['restaurantName']) || (data.restaurantName is string)) &&
             (!data.keys().hasAny(['contactName']) || (data.contactName is string)) &&
             (!data.keys().hasAny(['cuisineType']) || (data.cuisineType is string)) &&
             (!data.keys().hasAny(['restaurantSize']) || (data.restaurantSize is string)) &&
             (!data.keys().hasAny(['description']) || (data.description is string)) &&
             (!data.keys().hasAny(['website']) || (data.website is string)) &&
             (!data.keys().hasAny(['businessName']) || (data.businessName is string)) &&
             (!data.keys().hasAny(['businessAddress']) || (data.businessAddress is string)) &&
             (!data.keys().hasAny(['hourlyRate']) || (data.hourlyRate is number && data.hourlyRate >= 0)) &&
             (!data.keys().hasAny(['experience']) || (data.experience is list)) &&
             (!data.keys().hasAny(['skills']) || (data.skills is list)) &&
             (!data.keys().hasAny(['availability']) || (data.availability is list)) &&
             (!data.keys().hasAny(['education']) || (data.education is list)) &&
             (!data.keys().hasAny(['isActive']) || (data.isActive is bool)) &&
             (!data.keys().hasAny(['profileComplete']) || (data.profileComplete is bool)) &&
             (!data.keys().hasAny(['isVerified']) || (data.isVerified is bool)) &&
             (!data.keys().hasAny(['createdAt']) || (data.createdAt is timestamp)) &&
             (!data.keys().hasAny(['updatedAt']) || (data.updatedAt is timestamp)) &&
             (!data.keys().hasAny(['lastLogin']) || (data.lastLogin is timestamp));
    }

    function isValidJobData(data) {
      return data.keys().hasAll(['title', 'description', 'location', 'createdBy']) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.description is string && data.description.size() >= 10 && data.description.size() <= 5000 &&
             data.location is string && data.location.size() > 0 && data.location.size() <= 200 &&
             data.createdBy is string &&
             (!data.keys().hasAny(['salary']) || (data.salary is number && data.salary >= 0 && data.salary <= 1000000));
    }

    function isValidApplicationData(data) {
      return data.keys().hasAll(['applicantId', 'jobId', 'status']) &&
             data.applicantId is string &&
             data.jobId is string &&
             data.status is string && 
             data.status in ['pending', 'reviewed', 'accepted', 'rejected', 'withdrawn'] &&
             data.timestamp is timestamp;
    }

    function isValidMessageData(data) {
      return data.keys().hasAll(['senderId', 'recipientId', 'content', 'timestamp']) &&
             data.senderId is string &&
             data.recipientId is string &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 2000 &&
             data.timestamp is timestamp &&
             (!data.keys().hasAny(['encrypted']) || data.encrypted is bool);
    }

    // Rate limiting function (simple check)
    function isWithinRateLimit(userId, collection, maxRequests, timeWindowMinutes) {
      let recentRequests = query(
        resource,
        where('userId', '==', userId),
        where('timestamp', '>', timestamp.value(request.time.toMillis() - timeWindowMinutes * 60 * 1000))
      );
      return recentRequests.size() < maxRequests;
    }

    // User profiles with enhanced security
    match /users/{userId} {
      allow read: if isSignedIn() && 
                    (isOwner(userId) || isAdmin());
      
      // Simplified create rule for initial user registration
      allow create: if isSignedIn() && 
                      isOwner(userId) && 
                      request.auth.token.email == request.resource.data.email &&
                      request.resource.data.keys().hasAll(['email', 'userType', 'firstName', 'lastName']) &&
                      (request.resource.data.userType == 'applicant' || request.resource.data.userType == 'restaurant' || request.resource.data.userType == 'admin');
      
      allow update: if isSignedIn() && 
                      (isOwner(userId) || isAdmin()) &&
                      isValidUserProfileData(request.resource.data) &&
                      request.resource.data.email == resource.data.email &&
                      // Prevent userType changes by regular users
                      (isAdmin() || request.resource.data.userType == resource.data.userType);

      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Jobs with enhanced validation
    match /jobs/{jobId} {
      allow read: if true; // Jobs are public but with rate limiting in app
      
      allow create: if isSignedIn() && 
                      (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'restaurant' || isAdmin()) &&
                      isValidJobData(request.resource.data) &&
                      request.resource.data.createdBy == request.auth.uid;
                      // Removed email_verified requirement for job creation
      
      allow update: if isSignedIn() && 
                      (resource.data.createdBy == request.auth.uid || isAdmin()) &&
                      isValidJobData(request.resource.data) &&
                      request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if isSignedIn() && 
                      (resource.data.createdBy == request.auth.uid || isAdmin());
    }
    
    // Applications with enhanced security
    match /applications/{applicationId} {
      allow read: if isSignedIn() && 
                    (resource.data.applicantId == request.auth.uid || 
                     resource.data.restaurantId == request.auth.uid || 
                     isAdmin());
      
      allow create: if isSignedIn() && 
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'applicant' &&
                      isValidApplicationData(request.resource.data) &&
                      request.resource.data.applicantId == request.auth.uid &&
                      request.resource.data.timestamp == request.time;
                      // Removed email_verified requirement for applications
      
      allow update: if isSignedIn() && 
                      (resource.data.applicantId == request.auth.uid || 
                       resource.data.restaurantId == request.auth.uid || 
                       isAdmin()) &&
                      isValidApplicationData(request.resource.data) &&
                      request.resource.data.applicantId == resource.data.applicantId &&
                      request.resource.data.jobId == resource.data.jobId;
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Messages with encryption support
    match /messages/{messageId} {
      allow read: if isSignedIn() && 
                    (resource.data.senderId == request.auth.uid || 
                     resource.data.recipientId == request.auth.uid);
      
      allow create: if isSignedIn() && 
                      isValidMessageData(request.resource.data) &&
                      request.resource.data.senderId == request.auth.uid &&
                      request.resource.data.timestamp == request.time;
                      // Removed email_verified requirement for messages
      
      allow update: if false; // Messages are immutable
      
      allow delete: if isSignedIn() && 
                      (isAdmin() || resource.data.senderId == request.auth.uid);
    }
    
    // Conversations with enhanced security
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && 
                    (request.auth.uid in resource.data.participants);
      
      allow create: if isSignedIn() && 
                      (request.auth.uid in request.resource.data.participants) &&
                      request.resource.data.participants.size() >= 2 &&
                      request.resource.data.participants.size() <= 10;
                      // Removed email_verified requirement for conversations
      
      allow update: if isSignedIn() && 
                      (request.auth.uid in resource.data.participants) &&
                      request.resource.data.participants == resource.data.participants;
      
      allow delete: if isSignedIn() && isAdmin();
    }
    
    // Audit logs (read-only for users, write for system)
    match /auditLogs/{logId} {
      allow read: if isSignedIn() && 
                    (resource.data.userId == request.auth.uid || isAdmin());
      
      allow create: if isSignedIn() &&
                      request.resource.data.userId == request.auth.uid &&
                      request.resource.data.timestamp == request.time;
      
      allow update, delete: if false; // Audit logs are immutable
    }
    
    // Security events (admin only)
    match /securityEvents/{eventId} {
      allow read: if isSignedIn() && isAdmin();
      allow create: if isSignedIn() && 
                      (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if false; // Security events are immutable
    }
    
    // Notifications with enhanced privacy
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && 
                    resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && 
                      (isAdmin() || 
                       // Allow system-generated notifications
                       request.resource.data.userId == request.auth.uid);
      
      allow update: if isSignedIn() && 
                      resource.data.userId == request.auth.uid &&
                      // Only allow marking as read/unread
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt']);
      
      allow delete: if isSignedIn() && 
                      (isAdmin() || resource.data.userId == request.auth.uid);
    }

    // Data privacy and GDPR compliance
    match /dataPrivacy/{userId} {
      allow read: if isSignedIn() && 
                    (isOwner(userId) || isAdmin());
      
      allow create, update: if isSignedIn() && 
                              isOwner(userId);
      
      allow delete: if isSignedIn() && isAdmin();
    }

    // User consent and privacy settings
    match /privacySettings/{userId} {
      allow read, write: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isAdmin();
    }

    // Contact messages - public submission, admin-only access
    match /contactMessages/{messageId} {
      // Anyone can submit contact messages (public form)
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'subject', 'message', 'inquiryType']) &&
                      request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100 &&
                      request.resource.data.email is string && request.resource.data.email.matches('.+@.+\\..+') &&
                      request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 200 &&
                      request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000 &&
                      request.resource.data.inquiryType is string &&
                      request.resource.data.status == 'new';
      
      // Only admins can read and update contact messages
      allow read, update: if isSignedIn() && isAdmin();
      allow delete: if isSignedIn() && isAdmin();
    }
  }
}