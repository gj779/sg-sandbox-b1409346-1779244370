rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'admin';
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isRestaurant() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'restaurant';
    }
    
    function isApplicant() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userType == 'applicant';
    }
    
    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own profile
      // Admins can read all profiles
      // Restaurants can read applicant profiles who applied to their jobs
      allow read: if isOwner(userId) || isAdmin() || 
        (isRestaurant() && exists(/databases/$(database)/documents/applications/{applicationId}) && 
        get(/databases/$(database)/documents/applications/{applicationId}).data.restaurantId == request.auth.uid &&
        get(/databases/$(database)/documents/applications/{applicationId}).data.applicantId == userId);
      
      // Users can create their own profile during registration
      allow create: if isOwner(userId);
      
      // Users can update their own profile
      // Admins can update any profile
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete profiles
      allow delete: if isAdmin();
    }
    
    // Jobs collection
    match /jobs/{jobId} {
      // Anyone can read active and approved jobs
      // Restaurant owners can read their own jobs
      // Admins can read all jobs
      allow read: if (resource.data.isActive == true && resource.data.isApproved == true) || 
        (isRestaurant() && resource.data.restaurantId == request.auth.uid) || 
        isAdmin();
      
      // Only restaurants with verified email can create jobs
      allow create: if isRestaurant() && 
                     request.resource.data.restaurantId == request.auth.uid && 
                     isEmailVerified();
      
      // Restaurant owners can update their own jobs
      // Admins can update any job
      allow update: if (isRestaurant() && resource.data.restaurantId == request.auth.uid && isEmailVerified()) || 
                     isAdmin();
      
      // Restaurant owners can delete their own jobs
      // Admins can delete any job
      allow delete: if (isRestaurant() && resource.data.restaurantId == request.auth.uid && isEmailVerified()) || 
                     isAdmin();
    }
    
    // Applications collection
    match /applications/{applicationId} {
      // Applicants can read their own applications
      // Restaurants can read applications for their jobs
      // Admins can read all applications
      allow read: if (isApplicant() && resource.data.applicantId == request.auth.uid) || 
        (isRestaurant() && resource.data.restaurantId == request.auth.uid) || 
        isAdmin();
      
      // Applicants with verified email can create applications
      allow create: if isApplicant() && 
                     request.resource.data.applicantId == request.auth.uid && 
                     isEmailVerified();
      
      // Applicants can update their own applications
      // Restaurants can update applications for their jobs (status changes)
      // Admins can update any application
      // All require email verification
      allow update: if (isApplicant() && resource.data.applicantId == request.auth.uid && isEmailVerified()) || 
                     (isRestaurant() && resource.data.restaurantId == request.auth.uid && isEmailVerified()) || 
                     isAdmin();
      
      // Applicants can delete their own applications
      // Admins can delete any application
      allow delete: if (isApplicant() && resource.data.applicantId == request.auth.uid && isEmailVerified()) || 
                     isAdmin();
    }
    
    // Conversations collection
    match /conversations/{conversationId} {
      // Participants can read their conversations
      // Admins can read all conversations
      allow read: if isAuthenticated() && (resource.data.participants.hasAny([request.auth.uid])) || 
                   isAdmin();
      
      // Authenticated users with verified email can create conversations
      allow create: if isAuthenticated() && 
                     request.resource.data.participants.hasAny([request.auth.uid]) && 
                     isEmailVerified();
      
      // Participants with verified email can update their conversations
      // Admins can update any conversation
      allow update: if (isAuthenticated() && resource.data.participants.hasAny([request.auth.uid]) && isEmailVerified()) || 
                     isAdmin();
      
      // Only admins can delete conversations
      allow delete: if isAdmin();
    }
    
    // Messages collection
    match /messages/{messageId} {
      // Participants can read messages in their conversations
      // Admins can read all messages
      allow read: if isAuthenticated() && 
        exists(/databases/$(database)/documents/conversations/$(resource.data.conversationId)) &&
        get(/databases/$(database)/documents/conversations/$(resource.data.conversationId)).data.participants.hasAny([request.auth.uid]) || 
        isAdmin();
      
      // Authenticated users with verified email can send messages in their conversations
      allow create: if isAuthenticated() && 
                     exists(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)) &&
                     get(/databases/$(database)/documents/conversations/$(request.resource.data.conversationId)).data.participants.hasAny([request.auth.uid]) &&
                     isEmailVerified();
      
      // Message recipients with verified email can mark messages as read
      // Admins can update any message
      allow update: if (isAuthenticated() && resource.data.receiverId == request.auth.uid && isEmailVerified()) || 
                     isAdmin();
      
      // Only admins can delete messages
      allow delete: if isAdmin();
    }
    
    // System settings collection - admin only
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // Reports collection
    match /reports/{reportId} {
      // Anyone authenticated can create reports
      allow create: if isAuthenticated() && isEmailVerified();
      
      // Only the creator and admins can read reports
      allow read: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
      
      // Only admins can update or delete reports
      allow update, delete: if isAdmin();
    }
  }
}